#!/bin/sh
# ==============================================================================
# Pre-push Hook: Strictly prevent pushing any commits containing migration files
# ==============================================================================

z40=0000000000000000000000000000000000000000

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$local_sha" = "$z40" ]; then
        # Branch deletion, allow
        continue
    fi

    if [ "$remote_sha" = "$z40" ]; then
        # New branch on remote: check commits relative to origin/main or HEAD~1
        if git rev-parse --verify origin/main >/dev/null 2>&1; then
            range="origin/main..$local_sha"
        else
            range="$local_sha"
        fi
    else
        range="$remote_sha..$local_sha"
    fi

    MIGRATION_FILES=$(git diff --name-only "$range" 2>/dev/null | grep -E 'migrations/0[0-9]+.*\.py$')

    if [ -n "$MIGRATION_FILES" ]; then
        echo ""
        echo "======================================================================"
        echo "  [ERROR] PUSH REJECTED: Commits contain migration files!"
        echo "======================================================================"
        echo "The following migration file(s) were found in the commits being pushed:"
        echo "$MIGRATION_FILES"
        echo ""
        echo "POLICY: Migration files must NEVER be pushed to GitHub."
        echo "Please remove or uncommit them before pushing."
        echo "======================================================================"
        echo ""
        exit 1
    fi
done

exit 0
