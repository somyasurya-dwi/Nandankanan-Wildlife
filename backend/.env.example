# ==============================================================================
# NANDANKANAN ZOOLOGICAL PARK - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Django Secret Key (Generate a random unique string in production)
DJANGO_SECRET_KEY=django-insecure-nandankanan-wildlife-conservation-key-2026
DEBUG=True

# React Frontend Origin URL (Used to construct Password Reset links)
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# GMAIL SMTP CONFIGURATION (For sending welcome & password reset emails)
# ==============================================================================
# Instructions for Gmail SMTP:
# 1. Sign in to your Google Account (e.g. at https://myaccount.google.com/security).
# 2. Ensure "2-Step Verification" is turned ON.
# 3. Visit https://myaccount.google.com/apppasswords
# 4. Enter App name: "Nandankanan Zoo" and click Create.
# 5. Copy the 16-character code (e.g. 'abcd efgh ijkl mnop') and paste below into EMAIL_HOST_PASSWORD.
# 6. Set EMAIL_HOST_USER to your Gmail address.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_gmail_address@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=Nandankanan Zoological Park <your_gmail_address@gmail.com>
